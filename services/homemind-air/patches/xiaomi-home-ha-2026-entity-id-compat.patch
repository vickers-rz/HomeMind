+        The patch slugified the description, and an earlier revision of it
+        left a trailing separator behind when the description was empty once
+        slugified.
+        """
+        entity_id = (
+            f'{ha_domain}.{self._model_strs[0][:9]}_{self.did_tag}_'
+            f'{self._model_strs[-1][:20]}_s_{siid}')
+        return [
+            f'{entity_id}_{slugify_name(description)}',
+            f'{entity_id}_']
+
+    def gen_service_entity_id_legacy(
+        self, ha_domain: str, siid: int
+    ) -> list[str]:
+        """Return the service entity ids generated by previous versions.
+
+        The description of the service was appended to the id, an entity
+        registered before that change is still stored under the id without it.
+        """
+        return [
+            f'{ha_domain}.{self._model_strs[0][:9]}_{self.did_tag}_'
+            f'{self._model_strs[-1][:20]}_s_{siid}']
